// PolyMask local project data: JSON only, no executable expressions or full image files.
function PM_viewId(v){return v&&!v.isNull?v.id:"";}
function PM_referenceInfo(view){var im=view.image,samples=[];[.15,.5,.85].forEach(function(x){[.2,.5,.8].forEach(function(y){for(var c=0;c<im.numberOfNominalChannels;++c)samples.push(im.sample(Math.min(im.width-1,Math.floor(im.width*x)),Math.min(im.height-1,Math.floor(im.height*y)),c));});});return {id:view.id,path:view.window.filePath||"",width:im.width,height:im.height,channels:im.numberOfNominalChannels,samples:samples};}
function PM_projectWarnings(data,view){var a=data.reference,b=PM_referenceInfo(view),warnings=[];if(a.width!==b.width||a.height!==b.height)throw new Error("Project dimensions "+a.width+" × "+a.height+" do not match "+b.width+" × "+b.height+". Select the original reference. Coordinates will not be resized.");if(a.channels!==b.channels)throw new Error("The reference channel count does not match the project.");if(a.id!==b.id||a.path!==b.path)warnings.push("The reference name or file path differs from the saved project.");if(a.samples.length!==b.samples.length||a.samples.some(function(v,i){return Math.abs(v-b.samples[i])>1e-7;}))warnings.push("The sampled reference pixels differ. The image may have changed.");if(data.regions.some(function(r){return r.mode===0;}))warnings.push("This project used inward feathering. This version uses both-sides feathering for every region; review the updated boundaries.");if(!/^0\.3\.0-beta\.(11|12|13|14)$/.test(data.scriptVersion||"")&&data.regions.some(function(r){return r.color>0&&r.colorMode===0;}))warnings.push("This project used unnormalized chrominance masks. Chrominance is now normalized with bounded gain; review color masks before output.");return warnings;}
function PM_projectData(dialog){dialog.saveRegion();return {format:"Crinconlab PolyMask Project",schemaVersion:1,scriptVersion:"0.3.0-beta.14",reference:PM_referenceInfo(dialog.reference),activeRegion:dialog.activeRegion,regions:dialog.regions.map(function(r){return {name:r.name||"",points:r.selection.points.map(function(p){return{x:p.x,y:p.y};}),closed:r.selection.closed,feather:r.feather,mode:r.mode,invert:r.invert,strength:r.strength,operation:r.operation||0,color:r.color||0,colorMode:r.colorMode||0,lightEnabled:!!r.lightEnabled,lightLow:r.lightLow===undefined?0:r.lightLow,lightHigh:r.lightHigh===undefined?100:r.lightHigh,lightSoft:r.lightSoft||0};}),settings:{workMode:dialog.workMode.currentItem,maskA:PM_viewId(dialog.baseView.currentView),maskB:PM_viewId(dialog.otherView.currentView),operator:dialog.operationCode(),blur:dialog.finalBlur.value,invert:dialog.finalInvert.checked,drawMode:dialog.drawMode.currentItem,target:PM_viewId(dialog.targetView.currentView),outputName:dialog.outputName.text,attach:dialog.applyMask.checked,live:dialog.live.checked,useSTF:dialog.useSTF.checked,overlayColor:dialog.overlayColor.currentItem,opacity:dialog.opacity.value}};}
function PM_validateProject(data){if(!data||data.format!=="Crinconlab PolyMask Project"||data.schemaVersion!==1)throw new Error("Unsupported PolyMask project format or version.");var ref=data.reference;if(!ref||typeof ref.id!=="string"||typeof ref.path!=="string"||!Array.isArray(ref.samples))throw new Error("Invalid reference data.");PM_number(ref.width,"Reference width",1,100000);PM_number(ref.height,"Reference height",1,100000);if(ref.channels!==1&&ref.channels!==3)throw new Error("Invalid reference channels.");if(ref.samples.length!==9*ref.channels||ref.samples.some(function(x){return typeof x!=="number"||!isFinite(x);}))throw new Error("Invalid reference samples.");if(!Array.isArray(data.regions)||!data.regions.length||data.regions.length>32)throw new Error("A project must have 1 to 32 regions.");var regions=data.regions.map(function(r,i){if(!r||typeof r.name!=="string"||r.name.length>128||!Array.isArray(r.points)||r.points.length>64||typeof r.closed!=="boolean"||typeof r.invert!=="boolean"||typeof r.lightEnabled!=="boolean")throw new Error("Invalid region "+(i+1));var sel=new PM_PolygonSelection(ref.width,ref.height);sel.points=r.points.map(function(p){if(!p||typeof p.x!=="number"||typeof p.y!=="number")throw new Error("Invalid vertex.");return sel.point(PM_number(p.x,"Vertex X",0,ref.width),PM_number(p.y,"Vertex Y",0,ref.height));});sel.closed=r.closed;if(sel.closed)sel.polygon();function integer(v,n,hi){PM_number(v,n,0,hi);if(v!==Math.floor(v))throw new Error(n+" must be an integer.");return v;}return {name:r.name,selection:sel,feather:PM_number(r.feather,"Edge softness",0,250),mode:(integer(r.mode,"Feather mode",1),1),invert:r.invert,strength:PM_number(r.strength,"Strength",0,100),operation:integer(r.operation,"Region operation",3),color:integer(r.color,"Color",6),colorMode:integer(r.colorMode,"Color weight",1),lightEnabled:r.lightEnabled,lightLow:PM_number(r.lightLow,"Minimum L*",0,100),lightHigh:PM_number(r.lightHigh,"Maximum L*",0,100),lightSoft:PM_number(r.lightSoft,"Lightness transition",0,50)};});regions.forEach(function(r){if(r.lightLow>r.lightHigh)throw new Error("Minimum L* exceeds maximum L*.");});var a=data.activeRegion;if(!Number.isInteger(a)||a<0||a>=regions.length)throw new Error("Invalid active region.");var s=data.settings;if(!s)throw new Error("Missing project settings.");[['workMode',1],['operator',3],['drawMode',1],['overlayColor',2],['opacity',80]].forEach(function(k){if(!Number.isInteger(s[k[0]])||s[k[0]]<0||s[k[0]]>k[1])throw new Error("Invalid "+k[0]);});PM_number(s.blur,"Final blur",0,250);['invert','attach','live','useSTF'].forEach(function(k){if(typeof s[k]!=="boolean")throw new Error("Invalid "+k);});['maskA','maskB','target','outputName'].forEach(function(k){if(typeof s[k]!=="string"||s[k].length>256)throw new Error("Invalid "+k);});PM_validId(s.outputName);return regions;}
